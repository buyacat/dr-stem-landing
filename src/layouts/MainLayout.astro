---
import '../styles/style.css';
import { t, tArray } from '../utils/i18n';
import type { Locale } from '../utils/i18n';
import appScriptUrl from '../scripts/app.js?url';

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = '/' } = Astro.props;

const siteUrl = import.meta.env.SITE_URL || 'https://drstem.eu';

const title = t(locale, 'meta_title');
const description = t(locale, 'meta_description');
const keywords = t(locale, 'meta_keywords');
const ogTitle = t(locale, 'meta_og_title');
const ogDescription = t(locale, 'meta_og_description');
const twitterTitle = t(locale, 'meta_twitter_title');
const twitterDescription = t(locale, 'meta_twitter_description');
const robots = t(locale, 'meta_robots') || 'index, follow';

const canonical = siteUrl + path;
const ogImage = siteUrl + '/images/thumb.webp?v5';
const ogUrl = canonical;
const ogLocale = locale === 'uk' ? 'uk_UA' : 'en_US';

// Schema.org data
const schemaName = t(locale, 'schema_name');
const schemaDescription = t(locale, 'schema_description');
const schemaBrand = t(locale, 'schema_brand');
const schemaTelephone = t(locale, 'schema_telephone');
const schemaEmail = t(locale, 'schema_email');
const schemaAddressCountry = t(locale, 'schema_address_country');
const schemaAddressLocality = t(locale, 'schema_address_locality');
const schemaAddressStreet = t(locale, 'schema_address_street');
const schemaPriceRange = t(locale, 'schema_price_range');
const schemaSameAs = tArray<string>(locale, 'schema_same_as');

const schemaOrg = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": schemaName,
  "description": schemaDescription,
  "url": siteUrl,
  "logo": siteUrl + "/assets/logo.svg",
  "brand": {
    "@type": "Brand",
    "name": schemaBrand
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": schemaTelephone,
    "email": schemaEmail,
    "contactType": "sales",
    "availableLanguage": ["Ukrainian", "English"]
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": schemaAddressStreet,
    "addressLocality": schemaAddressLocality,
    "addressCountry": schemaAddressCountry
  },
  "priceRange": schemaPriceRange,
  "sameAs": schemaSameAs || []
}).replace(/</g, '\\u003c');

const appUrl = import.meta.env.DRSTEM_APP_URL || 'https://app.drstem.eu/#/';
const appDomain = (() => {
  try {
    return new URL(appUrl).hostname;
  } catch {
    return 'app.drstem.eu';
  }
})();

const otherLocale = locale === 'uk' ? 'en' : 'uk';
const otherPath = otherLocale === 'uk' ? '/' : '/en/';

// Scatter labels for app.js i18n
const scatterLabels = [
  t(locale, 'sensor_uv'),
  t(locale, 'sensor_conductivity'),
  t(locale, 'sensor_co2'),
  t(locale, 'sensor_soil_moisture'),
  t(locale, 'sensor_force'),
  t(locale, 'sensor_voltage'),
  t(locale, 'sensor_angle'),
  t(locale, 'sensor_temperature'),
  t(locale, 'sensor_current'),
  t(locale, 'sensor_light'),
  t(locale, 'sensor_heart_rate'),
  t(locale, 'sensor_gas_pressure'),
  t(locale, 'sensor_atmosphere')
];

const i18nData = {
  formSubmit: t(locale, 'form_submit'),
  formSending: t(locale, 'form_sending'),
  formSuccess: t(locale, 'form_success'),
  formSuccessHint: t(locale, 'form_success_hint'),
  formError: t(locale, 'form_error'),
  formErrorHint: t(locale, 'form_error_hint'),
  scatterLabels
};
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="google-site-verification" content="CaZhJ74E2-o0h9rK_mfcCsuZ7KUN8s8wnY2iPsz2daE" />
  <title>{title}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="robots" content={robots} />
  <meta name="theme-color" content="#1b6fe3" />
  <meta name="msapplication-TileColor" content="#1b6fe3" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Dr.STEM" />
  <meta name="application-name" content="Dr.STEM" />
  <meta name="format-detection" content="telephone=no" />
  <meta name="generator" content="Astro" />
  <link rel="canonical" href={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"></noscript>
  <link rel="icon" type="image/svg+xml" href="/assets/logo.svg">
  <link rel="apple-touch-icon" href="/assets/logo.svg">
  <link rel="mask-icon" href="/assets/logo.svg" color="#1b6fe3">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1342" />
  <meta property="og:image:height" content="997" />
  <meta property="og:image:alt" content={ogTitle} />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:site_name" content="Dr.STEM" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:title" content={twitterTitle} />
  <meta property="twitter:description" content={twitterDescription} />
  <meta property="twitter:image" content={ogImage} />
  <meta property="twitter:image:alt" content={twitterTitle} />
  <meta property="twitter:site" content="@drstem" />
  <meta property="twitter:creator" content="@drstem" />

  <!-- Hreflang -->
  <link rel="alternate" hreflang="uk" href={siteUrl + '/'} />
  <link rel="alternate" hreflang="en" href={siteUrl + '/en/'} />
  <link rel="alternate" hreflang="x-default" href={siteUrl + '/'} />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={schemaOrg} />

  <script define:vars={{ appUrl, appDomain, i18nData }}>
    window.DRSTEM_APP_URL = appUrl;
    window.DRSTEM_APP_DOMAIN = appDomain;
    window.DRSTEM_I18N = i18nData;
  </script>
</head>
<body itemscope itemtype="https://schema.org/WebPage">
  <template id="atom-mark">
    <svg viewBox="60 12 65 48" fill="none" xmlns="http://www.w3.org/2000/svg">
