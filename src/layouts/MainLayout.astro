    </svg>
  </template>

  <slot />

  <script is:inline src={appScriptUrl}></script>
  <script is:inline>
    (function(){ const tpl=document.getElementById('atom-mark');
      document.querySelectorAll('.mark').forEach(m=>m.appendChild(tpl.content.cloneNode(true))); })();
  </script>
</body>
</html>
