---
import MainLayout from '../layouts/MainLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Advantages from '../components/Advantages.astro';
import Includes from '../components/Includes.astro';
import Kits from '../components/Kits.astro';
import Software from '../components/Software.astro';
import AI from '../components/AI.astro';
import Game from '../components/Game.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import DotNav from '../components/DotNav.astro';
---

<MainLayout locale="en" path="/en/">
  <Nav locale="en" />
  <main>
    <Hero locale="en" />
    <Advantages locale="en" />
    <Includes locale="en" />
    <Kits locale="en" />
    <Software locale="en" />
    <AI locale="en" />
    <Game locale="en" />
    <CTA locale="en" />
  </main>
  <Footer locale="en" />
  <DotNav locale="en" />
</MainLayout>
