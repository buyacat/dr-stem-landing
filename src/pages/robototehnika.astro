---
import MainLayout from '../layouts/MainLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import RoboticsAdvantages from '../components/RoboticsAdvantages.astro';
import RoboticsIncludes from '../components/RoboticsIncludes.astro';
import RoboticsKitList from '../components/RoboticsKitList.astro';
import RoboticsCTA from '../components/RoboticsCTA.astro';
import { t, tArray } from '../utils/i18n';
import { withBase } from '../utils/url';

const locale = 'uk';

const stats = tArray<{ n: string; l: string }>(locale, 'robotics_stats');

// Dial hero: asymmetric left copy column + a scan-ring "dial" on the right
// (dashed protractor rings + ticks + node dots around the spider photo,
// dark badge chips for the car/house satellites). As the page scrolls the
// three rings turn at their own speeds and directions, the middle ring
// breathes its radius and morphs its dash pattern and colour (slate dots ->
// solid blue -> dashes), and the two satellite chips orbit the same centre
// counter-clockwise, opposite each other. The spider photo, the number
// badges, the satellite photos and their captions all stay upright.
---

<MainLayout locale={locale} path="/robototehnika/">
  <Nav locale={locale} />
  <main>
    <section class="hero" id="top">
      <div class="wrap robo-hero-grid">
        <div class="robo-hero-copy">
          <span class="eyebrow">{t(locale, 'robotics_eyebrow')}</span>
          <h1 set:html={t(locale, 'robotics_title')} />
          <p class="lede">{t(locale, 'robotics_lede')}</p>
          <div class="hero-stats">
            {stats.map((stat) => (
              <div class="s">
                <div class="n">{stat.n}</div>
                <div class="l">{stat.l}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="robo-dial">
          <svg class="robo-dial-rings" viewBox="0 0 660 660" fill="none" aria-hidden="true">
            <g class="robo-dial-ring robo-dial-ring--outer">
              <circle cx="330" cy="330" r="310" stroke="#4a525e" stroke-width="1.3" stroke-dasharray="2 9" opacity="0.4"/>
              <g stroke="#4a525e" stroke-width="1.3" opacity="0.5">
                <line x1="330" y1="10" x2="330" y2="34"/>
                <line x1="330" y1="626" x2="330" y2="650"/>
                <line x1="10" y1="330" x2="34" y2="330"/>
                <line x1="626" y1="330" x2="650" y2="330"/>
                <line x1="90" y1="90" x2="107" y2="107"/>
                <line x1="553" y1="107" x2="570" y2="90"/>
                <line x1="90" y1="570" x2="107" y2="553"/>
                <line x1="553" y1="553" x2="570" y2="570"/>
              </g>
              <circle cx="330" cy="20" r="2.4" fill="#333a44"/>
              <circle cx="330" cy="640" r="2.4" fill="#333a44"/>
              <circle cx="20" cy="330" r="2.4" fill="#333a44"/>
              <circle cx="640" cy="330" r="2.4" fill="#333a44"/>
            </g>
            <g class="robo-dial-ring robo-dial-ring--mid">
              <circle class="robo-dial-morph" cx="330" cy="330" r="245" stroke="var(--blue)" stroke-width="1.3" stroke-dasharray="2 9" opacity="0.35"/>
              <g class="robo-dial-nodes">
                <circle cx="156.76" cy="156.76" r="2" fill="var(--blue)"/>
                <circle cx="503.24" cy="503.24" r="2" fill="var(--blue)"/>
                <circle cx="156.76" cy="503.24" r="2" fill="var(--blue)"/>
                <circle cx="503.24" cy="156.76" r="2" fill="var(--blue)"/>
              </g>
            </g>
            <g class="robo-dial-ring robo-dial-ring--inner">
              <circle cx="330" cy="330" r="180" stroke="#4a525e" stroke-width="1.2" stroke-dasharray="1.5 7" opacity="0.32"/>
            </g>
            <circle cx="330" cy="330" r="8" fill="#333a44"/>
            <circle cx="330" cy="330" r="14" stroke="#333a44" stroke-width="1.3" opacity="0.5"/>
          </svg>

          <img class="robo-dial-photo" src={withBase("/assets/robotics/kits/r16.webp")} alt={t(locale, 'robotics_slot_spider')} loading="eager" />
          <div class="robo-dial-badge robo-dial-badge--main">01</div>

          <div class="robo-dial-sat robo-dial-sat--car">
            <div class="robo-dial-sat-circle"><img src={withBase("/assets/robotics/kits/r03.webp")} alt={t(locale, 'robotics_slot_car')} loading="eager" /></div>
            <div class="robo-dial-badge robo-dial-badge--sat">02</div>
            <span class="robo-dial-caption">{t(locale, 'robotics_slot_car')}</span>
          </div>

          <div class="robo-dial-sat robo-dial-sat--house">
            <div class="robo-dial-sat-circle"><img src={withBase("/assets/robotics/kits/r05.webp")} alt={t(locale, 'robotics_slot_house')} loading="eager" /></div>
            <div class="robo-dial-badge robo-dial-badge--sat">03</div>
            <span class="robo-dial-caption">{t(locale, 'robotics_slot_house')}</span>
          </div>
        </div>
      </div>
      <div class="scroll-cue"><div class="mouse"></div><span>{t(locale, 'scroll')}</span></div>
    </section>

    <RoboticsAdvantages locale={locale} />
    <RoboticsIncludes locale={locale} />
    <RoboticsKitList locale={locale} />
    <RoboticsCTA locale={locale} />
  </main>
  <Footer locale={locale} />
</MainLayout>

<style>
  .robo-hero-grid {
    display: grid;
    grid-template-columns: minmax(340px, 42%) 1fr;
    gap: 24px;
    align-items: center;
    padding: 150px 0 60px;
  }
  .robo-hero-copy .hero-stats {
    flex-wrap: wrap;
  }

  .robo-dial {
    position: relative;
    height: 560px;
  }
  .robo-dial-rings {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(560px, 100%);
    height: min(560px, 100%);
  }
  /* Each ring is driven separately by the scroll script: the groups rotate at
     their own speed/direction, and the middle blue ring also morphs its radius
     and dash pattern (see the inline script at the bottom of the page). */
  .robo-dial-ring,
  .robo-dial-nodes {
    transform-box: view-box;
    transform-origin: 330px 330px;
    will-change: transform;
  }

  .robo-dial-photo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(340px, 60%);
    filter: drop-shadow(0 34px 50px rgba(20, 40, 80, 0.28));
  }
  .robo-dial-badge {
    border-radius: 50%;
    background: #333a44;
    color: #fff;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .robo-dial-badge--main {
    position: absolute;
    top: 50%;
    left: 50%;
    margin-top: -158px;
    margin-left: 56px;
    width: 30px;
    height: 30px;
    font-size: 13px;
    box-shadow: 0 8px 18px -4px rgba(20, 25, 35, 0.5);
  }
  .robo-dial-badge--sat {
    width: 22px;
    height: 22px;
    font-size: 11px;
  }

  .robo-dial-sat {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .robo-dial-sat--car {
    top: 6%;
    left: 4%;
  }
  .robo-dial-sat--house {
    bottom: 6%;
    right: 2%;
  }
  /* Orbit mode. The script switches it on only when the dial box is wide
     enough for both chips to travel clear of the product photo; otherwise the
     corner placement above stays put (that is also the reduced-motion state).
     Chips are centred and then pushed onto an ellipse via --sat-x/--sat-y —
     pure translation, so photo, badge and caption never tumble. */
  .robo-dial--orbit .robo-dial-sat {
    top: 50%;
    left: 50%;
    right: auto;
    bottom: auto;
    transform: translate(-50%, -50%) translate(var(--sat-x, 0px), var(--sat-y, 0px));
    will-change: transform;
  }
  .robo-dial-sat-circle {
    position: relative;
    width: 116px;
    height: 116px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid #333a44;
    box-shadow: 0 18px 34px -14px rgba(20, 40, 70, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .robo-dial-sat-circle img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .robo-dial-sat .robo-dial-badge--sat {
    position: absolute;
    top: -4px;
    right: -4px;
  }
  .robo-dial-caption {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 600;
    font-size: 12.5px;
    text-align: center;
    color: var(--ink);
  }

  @media (max-width: 920px) {
    .robo-hero-grid {
      grid-template-columns: 1fr;
      padding: 120px 0 40px;
      gap: 40px;
    }
    .robo-hero-copy {
      text-align: center;
    }
    .robo-hero-copy .lede {
      margin-left: auto;
      margin-right: auto;
    }
    .robo-hero-copy .hero-stats {
      justify-content: center;
    }
    .robo-dial {
      height: 460px;
    }
    .robo-dial-sat-circle {
      width: 88px;
      height: 88px;
    }
  }

  @media (max-width: 560px) {
    .robo-dial {
      height: 380px;
    }
    .robo-dial-photo {
      width: 70%;
    }
    .robo-dial-sat-circle {
      width: 70px;
      height: 70px;
      padding: 10px;
    }
    .robo-dial-caption {
      font-size: 11px;
    }
  }
</style>

<script>
  (function () {
    var svg = document.querySelector('.robo-dial-rings');
    if (!svg) return;

    var outer = svg.querySelector('.robo-dial-ring--outer');
    var mid = svg.querySelector('.robo-dial-ring--mid');
    var inner = svg.querySelector('.robo-dial-ring--inner');
    var morph = svg.querySelector('.robo-dial-morph');
    var nodes = svg.querySelector('.robo-dial-nodes');
    if (!outer || !mid || !inner || !morph || !nodes) return;

    // Reduced motion: leave the authored markup untouched (sparse dotted
    // rings at their static radii) and never bind the scroll listener.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var dial = document.querySelector('.robo-dial');
    var photo = document.querySelector('.robo-dial-photo');
    var car = document.querySelector('.robo-dial-sat--car');
    var house = document.querySelector('.robo-dial-sat--house');

    // Satellite orbit. The two chips sit on opposite ends of one ellipse and
    // travel counter-clockwise; the ellipse is sized from the dial box so they
    // can never leave it or reach across to the copy column.
    var CAR_ANGLE = 210; // degrees — keeps the car chip up and to the left
    var ORBIT_SPEED = 0.055; // degrees per scrolled pixel
    var orbitX = 0;
    var orbitY = 0;
    var orbiting = false;

    function measure() {
      orbiting = false;
      if (!dial || !photo || !car || !house) return;

      var halfW = car.offsetWidth / 2;
      orbitX = Math.max(90, Math.min(dial.clientWidth / 2 - halfW - 8, 300));
      orbitY = Math.max(70, dial.clientHeight / 2 - car.offsetHeight / 2 - 4);

      // Only orbit when the chip clears the product photo at its tightest
      // point (the resting angle). On narrow layouts the box is simply too
      // small for that, and the corner placement is kept instead.
      var narrowest = Math.abs(Math.cos((CAR_ANGLE * Math.PI) / 180)) * orbitX;
      orbiting = narrowest - halfW - photo.offsetWidth / 2 >= 4;
      dial.classList.toggle('robo-dial--orbit', orbiting);
    }

    function place(el, x, y) {
      el.style.setProperty('--sat-x', x.toFixed(1) + 'px');
      el.style.setProperty('--sat-y', y.toFixed(1) + 'px');
    }

    var BASE_R = 245; // authored radius of the blue morph ring
    var R_SWING = 16; // a breath between 229 and 261 — never a dramatic jump

    // Story for the middle ring, one stop per state:
    // [dash, gap, opacity, stroke-width, r, g, b, energy]
    // The blue is earned: it starts as a calm slate and only saturates into
    // the brand blue as the reader scrolls into the solid state.
    var DOTS = [2, 9, 0.42, 1.3, 0x6f, 0x81, 0x99, 0];
    var SOLID = [16, 0, 0.6, 1.55, 0x1b, 0x6f, 0xe3, 1];
    var DASH = [18, 11, 0.5, 1.42, 0x3f, 0x82, 0xdd, 0.6];
    var STOPS = [DOTS, SOLID, DASH, DOTS];

    function lerp(a, b, t) {
      return a + (b - a) * t;
    }
    function easeInOut(t) {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }
    function clamp01(t) {
      return t < 0 ? 0 : t > 1 ? 1 : t;
    }

    var ticking = false;
    function update() {
      ticking = false;

      var y = window.scrollY || window.pageYOffset || 0;
      // The dial scrolls out of frame after roughly half a screen, so the whole
      // morph story is timed to finish while it is still visible, then rests.
      var span = Math.min(Math.max(window.innerHeight * 0.55, 380), 620);
      var p = clamp01(y / span);

      // Where the middle ring sits in its three-state story.
      var seg = p * 3;
      var i = Math.min(Math.floor(seg), 2);
      var k = easeInOut(clamp01(seg - i));
      var from = STOPS[i];
      var to = STOPS[i + 1];
      // 0 at rest, 1 at the solid peak — the whole dial takes its cue from it.
      var energy = lerp(from[7], to[7], k);
      var breath = Math.sin(p * Math.PI * 2);

      // Three rings, three speeds, alternating directions. The outer opens as
      // the two inner ones close, so the dial reads like an aperture.
      outer.style.transform =
        'rotate(' + ((y * 0.05) % 360).toFixed(2) + 'deg) scale(' + (1 + breath * 0.014).toFixed(4) + ')';
      outer.style.opacity = (0.86 + energy * 0.14).toFixed(3);

      mid.style.transform = 'rotate(' + ((-y * 0.085) % 360).toFixed(2) + 'deg)';

      inner.style.transform =
        'rotate(' + ((y * 0.135) % 360).toFixed(2) + 'deg) scale(' + (1 - breath * 0.032).toFixed(4) + ')';
      inner.style.opacity = (0.8 + energy * 0.2).toFixed(3);

      // Middle ring: radius breathes over the same scroll span.
      var r = BASE_R - R_SWING * breath;
      morph.setAttribute('r', r.toFixed(2));
      // Keep the node dots seated on the ring while it breathes.
      nodes.style.transform = 'scale(' + (r / BASE_R).toFixed(4) + ')';

      // Middle ring: dash pattern and colour walk through the three states.
      var dash = lerp(from[0], to[0], k);
      var gap = lerp(from[1], to[1], k);

      morph.setAttribute(
        'stroke-dasharray',
        gap < 0.2 ? 'none' : dash.toFixed(2) + ' ' + gap.toFixed(2)
      );
      morph.setAttribute('opacity', lerp(from[2], to[2], k).toFixed(3));
      morph.setAttribute('stroke-width', lerp(from[3], to[3], k).toFixed(2));
      morph.setAttribute(
        'stroke',
        'rgb(' +
          Math.round(lerp(from[4], to[4], k)) + ',' +
          Math.round(lerp(from[5], to[5], k)) + ',' +
          Math.round(lerp(from[6], to[6], k)) + ')'
      );

      // Satellites: the pair travels counter-clockwise around the same centre,
      // staying opposite each other. Pure translation — nothing tumbles.
      if (orbiting) {
        var a = ((CAR_ANGLE - y * ORBIT_SPEED) * Math.PI) / 180;
        var ox = Math.cos(a) * orbitX;
        var oy = Math.sin(a) * orbitY;
        place(car, ox, oy);
        place(house, -ox, -oy);
      }
    }

    window.addEventListener(
      'scroll',
      function () {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    window.addEventListener(
      'resize',
      function () {
        measure();
        update();
      },
      { passive: true }
    );
    measure();
    update();
  })();
</script>
