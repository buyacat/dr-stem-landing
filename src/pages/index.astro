---
import MainLayout from '../layouts/MainLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Advantages from '../components/Advantages.astro';
import Includes from '../components/Includes.astro';
import Kits from '../components/Kits.astro';
import Software from '../components/Software.astro';
import AI from '../components/AI.astro';
import Game from '../components/Game.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import DotNav from '../components/DotNav.astro';
---

<MainLayout locale="uk" path="/">
  <Nav locale="uk" />
  <main>
    <Hero locale="uk" />
    <Advantages locale="uk" />
    <Includes locale="uk" />
    <Kits locale="uk" />
    <Software locale="uk" />
    <AI locale="uk" />
    <Game locale="uk" />
    <CTA locale="uk" />
  </main>
  <Footer locale="uk" />
  <DotNav locale="uk" />
</MainLayout>
