---
import { t, tArray } from '../utils/i18n';
import type { Locale } from '../utils/i18n';
import { withBase } from '../utils/url';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const aiImg400 = withBase('/images/img-ai-400.webp');
const aiImg700 = withBase('/images/img-ai.webp');
const questions = tArray<string>(locale, 'ai_questions');
const features = tArray<string>(locale, 'ai_features');
const aiIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5M4 12h16M16 8l4 4-4 4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.8.8 1 1.5 1 2.5h6c0-1 .2-1.7 1-2.5A6 6 0 0 0 12 3Z"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 2"/></svg>',
];
---

<section class="band split alt-b" id="ai">
  <div class="wrap">
    <div class="split-grid reverse">
      <div class="visual visual-slot">
        <img style="max-width:100%; border-radius: 24px" src={aiImg400} srcset={`${aiImg400} 400w, ${aiImg700} 700w`} sizes="(max-width: 768px) 90vw, 400px" alt={t(locale, 'ai_img_alt')} width="700" height="549" loading="lazy" decoding="async">
      </div>
      <div class="split-copy">
        <span class="eyebrow">{t(locale, 'ai_eyebrow')}</span>
        <h2 set:html={t(locale, 'ai_title')} />
        <p class="intro">{t(locale, 'ai_intro')}</p>
        <div class="qa">
          {questions.map(q => (
            <div class="qbub">{q}</div>
          ))}
        </div>
        <div class="feat-list">
          {features.map((feat, i) => (
            <div class="feat">
              <span class="fk" set:html={aiIcons[i]} />
              <span>{feat}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
