---
import { t, tArray } from '../utils/i18n';
import type { Locale } from '../utils/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const advantages = tArray<{num: string; icon: string; highlight?: boolean; title: string; desc: string}>(locale, 'robotics_advantages');

/*
 * Шість власних іконок сторінки — той самий набір правил, що в
 * Advantages.astro (там же й повна специфікація ваг, вузлів і радіусів).
 * Раніше п'ять із шести були байт-у-байт скопійовані з головної й переклеєні
 * на інші тези: гаманець стояв біля «українського виробництва», лінійний
 * графік — біля Arduino. Тепер жодна не повторюється.
 */
const icons: Record<string, string> = {
  // Рівно 18 тіків по колу: число і є іконка. Тіки однакової довжини — при
  // чергуванні довгий/короткий око рахує дев'ять. У центрі стос наборів.
  sets18: '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><g stroke-width="1.2" opacity=".4"><path d="M24 4v3M30.84 5.21 29.81 8.02M36.86 8.68 34.93 10.98M41.32 14 38.72 15.5M43.7 20.53 40.74 21.05M43.7 27.47 40.74 26.95M41.32 34 38.72 32.5M36.86 39.32 34.93 37.02M30.84 42.79 29.81 39.98M24 44v-3M17.16 42.79 18.19 39.98M11.14 39.32 13.07 37.02M6.68 34 9.28 32.5M4.3 27.47 7.26 26.95M4.3 20.53 7.26 21.05M6.68 14 9.28 15.5M11.14 8.68 13.07 10.98M17.16 5.21 18.19 8.02"/></g><rect x="14.6" y="16.6" width="14" height="10" rx="2.5" stroke-width="1.2"/><rect x="17" y="19" width="14" height="10" rx="2.5" stroke-width="1.2"/><rect x="19.4" y="21.4" width="14" height="10" rx="2.5" stroke-width="1.6"/></svg>',
  // Два діапазони класів — дві дзеркальні дужки з розривами на 12 і 6.
  // Родич `span` з головної, але сплутати неможливо: там одна суцільна арка.
  spans: '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><g stroke-width="1.2" opacity=".4"><path d="M24 4v3M34 6.68 32.5 9.28M41.32 14 38.72 15.5M44 24h-3M41.32 34 38.72 32.5M34 41.32 32.5 38.72M24 44v-3M14 41.32 15.5 38.72M6.68 34 9.28 32.5M4 24h3M6.68 14 9.28 15.5M14 6.68 15.5 9.28"/></g><path d="M14 6.68A20 20 0 0 0 14 41.32" stroke-width="2.4"/><path d="M34 6.68A20 20 0 0 1 34 41.32" stroke-width="2.4"/><circle cx="14" cy="6.68" r="2.4" fill="currentColor" stroke="none"/><circle cx="14" cy="41.32" r="2.4" fill="currentColor" stroke="none"/><circle cx="34" cy="6.68" r="2.4" fill="currentColor" stroke="none"/><circle cx="34" cy="41.32" r="2.4" fill="currentColor" stroke="none"/><circle cx="24" cy="24" r="2.4" fill="currentColor" stroke="none"/></svg>',
  // Список проєктів у центрі, сектор на кільці — глибина від 5 до 50.
  // Незроблений пункт — порожня мікро-крапка, а не залита під прозорістю.
  projects: '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="24" r="20" pathLength="120" stroke-dasharray="1.4 3.6" stroke-width="1.2" opacity=".4"/><path d="M24 4A20 20 0 0 1 41.32 34" stroke-width="2.4"/><circle cx="24" cy="4" r="2.4" fill="currentColor" stroke="none"/><circle cx="41.32" cy="34" r="2.4" fill="currentColor" stroke="none"/><path d="M20.5 18.5h11M20.5 24h11M20.5 29.5h7" stroke-width="1.6"/><circle cx="16.5" cy="18.5" r="1.5" fill="currentColor" stroke="none"/><circle cx="16.5" cy="24" r="1.5" fill="currentColor" stroke="none"/><circle cx="16.5" cy="29.5" r="1.5" stroke-width="1.2"/></svg>',
  // Мікроконтролер із пінами; на кільці два вузли-опозиція: круглий — блочне
  // програмування, квадратний — текстове. Квадрат менший: при рівній ширині
  // він оптично важчий за коло.
  board: '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="24" r="20" pathLength="120" stroke-dasharray="1.4 3.6" stroke-width="1.2" opacity=".4"/><rect x="16.5" y="16.5" width="15" height="15" rx="2.5" stroke-width="1.6"/><path d="M16.5 19h-5M16.5 24h-5M16.5 29h-5M31.5 19h5M31.5 24h5M31.5 29h5" stroke-width="1.2"/><circle cx="34" cy="6.68" r="2.4" fill="currentColor" stroke="none"/><rect x="11.8" y="4.48" width="4.4" height="4.4" rx="1.2" fill="currentColor" stroke="none"/></svg>',
  // Клеймо походження. Монохромне синє: жовтий у сітці лишається один — на
  // картці «Навчальні проєкти».
  stamp: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="24" r="20" pathLength="120" stroke-dasharray="1.4 3.6" stroke-width="1.2" opacity=".4"/><circle cx="24" cy="24" r="15" stroke-width="1.2"/><circle cx="9" cy="24" r="1.5" fill="currentColor" stroke="none"/><circle cx="39" cy="24" r="1.5" fill="currentColor" stroke="none"/><text x="24" y="29.4" text-anchor="middle" font-family="'Space Grotesk', 'IBM Plex Sans', system-ui, sans-serif" font-size="15" font-weight="700" letter-spacing="-0.5" fill="currentColor" stroke="none">UA</text></svg>`,
  // Ручка-регулятор із позначкою і дуга повороту. Позначка РАДІАЛЬНА: хорда
  // впоперек кола читається як ⊖ «заборонено» — протилежне до змісту картки.
  knob: '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="24" r="20" pathLength="120" stroke-dasharray="1.4 3.6" stroke-width="1.2" opacity=".4"/><path d="M9.9 18.87A15 15 0 0 1 38.1 18.87" stroke-width="1.2"/><path d="M35.38 16.67 38.1 18.87 38.76 15.43" stroke-width="1.2"/><circle cx="24" cy="24" r="10" stroke-width="1.6"/><path d="M26 20.54 29 15.34" stroke-width="2.4"/><circle cx="24" cy="24" r="1.5" fill="currentColor" stroke="none"/></svg>',
};
---

<section class="band advantages" id="advantages" itemscope itemtype="https://schema.org/ItemList">
  <div class="wrap">
    <div class="band-head">
      <span class="eyebrow center">{t(locale, 'robotics_advantages_eyebrow')}</span>
      <h2 set:html={t(locale, 'robotics_advantages_title')} />
      <p>{t(locale, 'robotics_advantages_desc')}</p>
    </div>
    <div class="adv-grid">
      {advantages.map((adv, i) => (
        <div class={`adv ${adv.highlight ? 'y' : ''}`} itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <meta itemprop="position" content={String(i + 1)} />
          <span class="num" aria-hidden="true">{adv.num}</span>
          <div class="ic" set:html={icons[adv.icon]} />
          <h3 itemprop="name">{adv.title}</h3>
          <p itemprop="description">{adv.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
