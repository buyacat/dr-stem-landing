---
import { t, tArray } from '../utils/i18n';
import type { Locale } from '../utils/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const kits = tArray<{code: string; name: string}>(locale, 'robotics_kits_list');

// Phase 1 (current): plain wording + a link to a PDF catalog — no per-kit
// cards/specs/images yet, per client's "будемо робити вкінці" note.
// Phase 2 (future): expand this into full per-kit cards/specs, modeled on
// Kits.astro/KitTab.astro/KitPanel.astro's tab+panel pattern, once kit
// photos and final copy are approved. Source photos for that phase:
// https://drive.google.com/drive/folders/1G0GrLkDs8F7vNG5R-SwkTGG3OvZDwuWe
---

<section class="band" id="kits">
  <div class="wrap">
    <div class="band-head">
      <span class="eyebrow center">{t(locale, 'robotics_kits_eyebrow')}</span>
      <h2 set:html={t(locale, 'robotics_kits_title')} />
      <p>{t(locale, 'robotics_kits_intro')}</p>
    </div>
    <div class="rk-grid">
      {kits.map(kit => (
        <div class="rk-item">
          <span class="rk-code">{kit.code}</span>
          <span class="rk-name">{kit.name}</span>
        </div>
      ))}
    </div>
    <div class="rk-cta">
      <a class="btn btn-primary" href="/assets/robotics/catalog.pdf" target="_blank" rel="noopener" download>{t(locale, 'robotics_kits_pdf_label')}</a>
    </div>
  </div>
</section>

<style>
  .rk-grid {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .rk-item {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 16px 20px;
    background: #fff;
    border: 1.5px solid var(--line);
    border-radius: 14px;
  }
  .rk-code {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--blue);
    flex-shrink: 0;
  }
  .rk-name {
    font-size: 14.5px;
    color: var(--ink);
  }
  .rk-cta {
    display: flex;
    justify-content: center;
    margin-top: 36px;
  }
  @media (max-width: 900px) {
    .rk-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .rk-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
