---
import { t, tArray } from '../utils/i18n';
import type { Locale } from '../utils/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const features = tArray<string>(locale, 'software_features');
const checkIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
---

<section class="band split alt-a" id="software" itemscope itemtype="https://schema.org/SoftwareApplication">
  <div class="wrap">
    <div class="split-grid">
      <div class="split-copy">
        <span class="eyebrow">{t(locale, 'software_eyebrow')}</span>
        <h2 itemprop="name" set:html={t(locale, 'software_title')} />
        <p class="intro" itemprop="description">{t(locale, 'software_intro')}</p>
        <div class="feat-list">
          {features.map((feat) => (
            <div class="feat">
              <span class="fk" set:html={checkIcon} />
              <span itemprop="featureList">{feat}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="visual visual-slot">
        <div class="browser-frame">
          <div class="browser-bar">
            <span class="b-dot bd-red"></span>
            <span class="b-dot bd-yel"></span>
            <span class="b-dot bd-grn"></span>
            <div class="b-url">{t(locale, 'software_browser_url')}</div>
          </div>
          <div class="software-video-wrap">
            <video class="software-video" src="https://trade.eddygroup.eu/wp-content/themes/elementra-child/assets/video/dsl-DtgtupLg.mp4" autoplay muted loop playsinline></video>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
