---
import { t, tArray } from '../utils/i18n';
import type { Locale } from '../utils/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const features = tArray<string>(locale, 'software_features');
// Пункт списку — маленьке «закрито» в тому ж словнику, що іконки переваг:
// пунктирне кільце тримає галочку замість плитки-підкладки.
// pathLength="48" з періодом 3 дає рівно 16 штрихів, і кільце змикається без шва.
const checkIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="11" pathLength="48" stroke-dasharray="1 2" stroke-width="1.1" opacity=".45"/><path d="M7.6 12.3 10.6 15.3 16.4 8.9" stroke-width="1.7"/></svg>';
---

<section class="band split alt-a" id="software" itemscope itemtype="https://schema.org/SoftwareApplication">
  <div class="wrap">
    <div class="split-grid">
      <div class="split-copy">
        <span class="eyebrow">{t(locale, 'software_eyebrow')}</span>
        <h2 itemprop="name" set:html={t(locale, 'software_title')} />
        <p class="intro" itemprop="description">{t(locale, 'software_intro')}</p>
        <div class="feat-list">
          {features.map((feat) => (
            <div class="feat">
              <span class="fk fk--dashed" set:html={checkIcon} />
              <span itemprop="featureList">{feat}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="visual visual-slot">
        <div class="browser-frame">
          <div class="browser-bar">
            <span class="b-dot bd-red"></span>
            <span class="b-dot bd-yel"></span>
            <span class="b-dot bd-grn"></span>
            <div class="b-url">{t(locale, 'software_browser_url')}</div>
          </div>
          <div class="software-video-wrap">
            <video class="software-video" src="/assets/software-demo.mp4" autoplay muted loop playsinline preload="metadata" width="1280" height="724"></video>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
