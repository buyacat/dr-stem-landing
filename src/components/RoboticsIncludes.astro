---
import { t, tArray } from '../utils/i18n';
import type { Locale } from '../utils/i18n';
import { withBase } from '../utils/url';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const items = tArray<{icon: string; title: string; desc: string; highlight?: boolean}>(locale, 'robotics_includes');
const quotes = tArray<{text: string; author: string}>(locale, 'robotics_video_quotes');

const icons: Record<string, string> = {
  module: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 11h8M9 21v-3h6v3"/></svg>',
  box: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8l9 5 9-5Z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></svg>',
  code: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 9l-4 3 4 3M16 9l4 3-4 3M13 5l-2 14"/></svg>',
  book: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h12a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H6a2 2 0 0 1-2-2V5Z"/><path d="M4 17a2 2 0 0 1 2-2h13M9 7h6"/></svg>',
};
---

<section class="band split alt-a" id="includes">
  <div class="wrap">
    <div class="split-grid">
      <div class="split-copy reveal">
        <span class="eyebrow">{t(locale, 'robotics_includes_eyebrow')}</span>
        <h2 set:html={t(locale, 'robotics_includes_title')} />
        <p class="intro">{t(locale, 'robotics_includes_desc')}</p>
        <div class="feat-list">
          {items.map((item) => (
            <div class="feat">
              <span class="fk" set:html={icons[item.icon]} />
              <span>{item.title}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="visual visual-slot reveal-crt" style="transition-delay:0.12s">
        <div class="photo-frame" id="pf-quote-frame" data-quotes={JSON.stringify(quotes)}>
          <div class="software-video-wrap">
            <video class="software-video" src={withBase('/assets/robotics/video/kits-loop-30s.mp4')} autoplay muted loop playsinline preload="auto" width="960" height="540"></video>
          </div>
          <div class="pf-quote" id="pf-quote" aria-live="polite"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const frame = document.getElementById('pf-quote-frame');
    const quoteEl = document.getElementById('pf-quote');
    if (!frame || !quoteEl) return;

    let quotes: { text: string; author: string }[] = [];
    try {
      quotes = JSON.parse(frame.getAttribute('data-quotes') || '[]');
    } catch {
      quotes = [];
    }
    if (!quotes.length) return;

    let index = -1;
    let hideTimer: ReturnType<typeof setTimeout> | null = null;

    frame.addEventListener('click', () => {
      let next = index;
      if (quotes.length > 1) {
        while (next === index) next = Math.floor(Math.random() * quotes.length);
      } else {
        next = 0;
      }
      index = next;
      const q = quotes[index];
      quoteEl.innerHTML = `“${q.text}”<span class="pf-quote-author">— ${q.author}</span>`;
      quoteEl.classList.add('show');
      if (hideTimer) clearTimeout(hideTimer);
      hideTimer = setTimeout(() => quoteEl.classList.remove('show'), 4200);
    });
  })();
</script>
