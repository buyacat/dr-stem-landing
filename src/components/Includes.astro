---
import { t, tArray } from '../utils/i18n';
import type { Locale } from '../utils/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const items = tArray<{icon: string; title: string; desc: string; highlight?: boolean}>(locale, 'includes');

const icons: Record<string, string> = {
  monitor: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/></svg>',
  module: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 11h8M9 21v-3h6v3"/></svg>',
  sensor: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 14.8V5a2 2 0 0 0-4 0v9.8a4 4 0 1 0 4 0Z"/><path d="M12 9v6"/></svg>',
  code: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 9l-4 3 4 3M16 9l4 3-4 3M13 5l-2 14"/></svg>',
  book: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h12a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H6a2 2 0 0 1-2-2V5Z"/><path d="M4 17a2 2 0 0 1 2-2h13M9 7h6"/></svg>',
};
---

<section class="band includes" id="includes">
  <div class="scatter" id="scatter" data-i18n="scatter"></div>
  <div class="wrap">
    <div class="band-head reveal">
      <span class="eyebrow center">{t(locale, 'includes_eyebrow')}</span>
      <h2 set:html={t(locale, 'includes_title')} />
      <p>{t(locale, 'includes_desc')}</p>
    </div>
    <div class="inc-grid">
      {items.map((item, i) => (
        <div class="inc reveal" style={`transition-delay:${(i % 4) * 0.08}s`}>
          <div class:list={["ic", { "ic--flip": item.highlight }]} set:html={icons[item.icon]} />
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
