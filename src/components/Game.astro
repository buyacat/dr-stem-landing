---
import { t, tArray } from '../utils/i18n';
import type { Locale } from '../utils/i18n';
import { withBase } from '../utils/url';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const gameVideo = withBase('/assets/game/lab-loop.mp4');
const gameVideoPoster = withBase('/assets/game/lab-loop-poster.jpg');
const features = tArray<string>(locale, 'game_features');
const missions = tArray<string>(locale, 'game_missions');
const gameIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v5a8 8 0 0 1-16 0V4ZM8 21h8M12 17v4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3 8 4-16 3 8h4"/></svg>',
];
---

<section class="band game-band" id="game">
  <video class="game-bg-video" src={gameVideo} poster={gameVideoPoster} autoplay muted loop playsinline preload="auto" width="1600" height="900" aria-hidden="true"></video>
  <div class="game-bg-scrim" aria-hidden="true"></div>
  <div class="wrap">
    <div class="game-content reveal">
      <span class="eyebrow center">{t(locale, 'game_eyebrow')}</span>
      <h2 class="game-hero-title" set:html={t(locale, 'game_title')} />
      <p class="game-hero-intro">{t(locale, 'game_intro')}</p>
      <div class="game-hero-feats">
        {features.map((feat, i) => (
          <div class="ghf">
            <span class="fk" set:html={gameIcons[i]} />
            <span>{feat}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="game-support reveal" style="transition-delay:0.14s">
      <h3 class="game-support-label">{t(locale, 'game_missions_label')}</h3>
      <div class="sensor-chips" style="justify-content:center">
        {missions.map(m => (
          <span class="schip"><span class="sd"></span><span>{m}</span></span>
        ))}
      </div>
      <div class="kit-note">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 20h8M12 18v2M7 9h4M7 13h7"/></svg>
        <p set:html={t(locale, 'game_dashboard')} />
      </div>
    </div>
  </div>
</section>
