---
import { t, tArray } from '../utils/i18n';
import type { Locale } from '../utils/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const features = tArray<string>(locale, 'game_features');
const missions = tArray<string>(locale, 'game_missions');
const gameIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v5a8 8 0 0 1-16 0V4ZM8 21h8M12 17v4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3 8 4-16 3 8h4"/></svg>',
];
---

<section class="band split alt-c" id="game">
  <div class="wrap">
    <div class="split-grid">
      <div class="split-copy">
        <span class="eyebrow">{t(locale, 'game_eyebrow')}</span>
        <h2 set:html={t(locale, 'game_title')} />
        <p class="intro">{t(locale, 'game_intro')}</p>
        <div class="feat-list">
          {features.map((feat, i) => (
            <div class="feat">
              <span class="fk" set:html={gameIcons[i]} />
              <span>{feat}</span>
            </div>
          ))}
        </div>
        <h3 style="font-family:'Space Grotesk';font-size:13px;text-transform:uppercase;letter-spacing:.07em;color:var(--slate);margin:24px 0 12px">{t(locale, 'game_missions_label')}</h3>
        <div class="sensor-chips">
          {missions.map(m => (
            <span class="schip"><span class="sd"></span><span>{m}</span></span>
          ))}
        </div>
        <div class="kit-note" style="margin-top:24px;justify-content:flex-start">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 20h8M12 18v2M7 9h4M7 13h7"/></svg>
          <p set:html={t(locale, 'game_dashboard')} />
        </div>
      </div>
      <div class="visual visual-slot">
        <img style="max-width:100%; border-radius: 24px" src="/images/img-game3-400.webp" srcset="/images/img-game3-400.webp 400w, /images/img-game3.webp 800w" sizes="(max-width: 768px) 90vw, 400px" alt={t(locale, 'game_img_alt')} width="800" height="689" loading="lazy" decoding="async">
      </div>
    </div>
  </div>
</section>
