---
import { t, tArray } from '../utils/i18n';
import type { Locale } from '../utils/i18n';
import { withBase } from '../utils/url';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const corpLinks = tArray<{ label: string; url: string }>(locale, 'nav_corp_links');
---

<footer class="footer footer-inline" itemscope itemtype="https://schema.org/Organization">
  <div class="wrap">
    <div class="footer-top">
      <a href="#top" class="footer-logo" itemprop="url">
        <img src={withBase('/assets/logo.svg')} alt="Dr.STEM" style="height:36px;width:auto;opacity:.6;filter:brightness(0) invert(1)" width="110" height="91" itemprop="logo">
      </a>
      <div class="footer-contacts">
        <a href={`mailto:${t(locale, 'footer_email')}`} itemprop="email">{t(locale, 'footer_email')}</a>
        <a href={`tel:${t(locale, 'footer_phone').replace(/\s/g, '')}`} itemprop="telephone">{t(locale, 'footer_phone')}</a>
        <span itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
          <span itemprop="streetAddress">{t(locale, 'footer_address')}</span>
        </span>
      </div>
    </div>
    <div class="footer-mid">
      <div class="fl-group">
        <span class="fl-label">{t(locale, 'footer_family_label')}</span>
        <div class="fl">
          {corpLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
          ))}
        </div>
      </div>
      <div class="soc">
        <a href="https://www.facebook.com/profile.php?id=61576618363606" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h2.5l.5-3H14V9.5c0-.3.2-.5.5-.5Z"/></svg></a>
          <a href="https://www.youtube.com/@eddy-group" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 8.2a3 3 0 0 0-2-2C18.2 5.7 12 5.7 12 5.7s-6.2 0-8 .5a3 3 0 0 0-2 2C1.5 10 1.5 12 1.5 12s0 2 .5 3.8a3 3 0 0 0 2 2c1.8.5 8 .5 8 .5s6.2 0 8-.5a3 3 0 0 0 2-2c.5-1.8.5-3.8.5-3.8s0-2-.5-3.8ZM10 15V9l5 3-5 3Z"/></svg></a>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="cp">{t(locale, 'footer_copyright')}</div>
    </div>
  </div>
</footer>
